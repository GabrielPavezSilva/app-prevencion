# Variables del stack de Docker (compose.yml y compose.staging.yml).
# Copiar a .env y completar. El archivo .env está en .gitignore.

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_DB=db_prevencion
POSTGRES_USER=prevencion
POSTGRES_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────────────────
# Firma los JWT: un valor aleatorio y largo, distinto por ambiente.
JWT_SECRET_KEY=
ENVIRONMENT=production

# ── Base de RRHH (fuente de verdad del personal, solo lectura) ────────────────
# En el VPS el software corre en el mismo servidor que esa base, así que
# host.docker.internal alcanza: no hace falta túnel.
EMPLOYEES_DB_HOST=host.docker.internal
EMPLOYEES_DB_PORT=5432
EMPLOYEES_DB_NAME=rh_cramer
EMPLOYEES_DB_USER=
EMPLOYEES_DB_PASSWORD=
