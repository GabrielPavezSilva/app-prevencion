# Configuración del backend para desarrollo local.
# Copiar a Backend/.env y completar. El archivo .env está en .gitignore.

# ── Base de la aplicación ─────────────────────────────────────────────────────
# Una URL completa, o los campos sueltos DB_HOST_PG / DB_PORT_PG / DB_USER_PG /
# DB_PASSWORD_PG / DB_NAME_PG. El puerto 5433 es el contenedor de desarrollo.
DATABASE_URL=postgresql+psycopg2://postgres:<clave>@localhost:5433/db_prevencion

# ── Sesión ────────────────────────────────────────────────────────────────────
# Firma los JWT. En producción, un valor aleatorio y largo.
JWT_SECRET_KEY=dev-secret-cambiar
JWT_EXPIRE_MINUTES=480

# ── Base de RRHH (fuente de verdad del personal, solo lectura) ────────────────
# En local se llega por túnel SSH:
#   ssh -N -L 5434:localhost:5432 <usuario>@<host-rrhh>
# Puerto local 5434 — nunca 5433, que es la base de desarrollo.
EMPLOYEES_DB_USER=<usuario>
EMPLOYEES_DB_PASSWORD=<clave>
EMPLOYEES_DB_HOST=localhost
EMPLOYEES_DB_PORT=5434
EMPLOYEES_DB_NAME=rh_cramer
